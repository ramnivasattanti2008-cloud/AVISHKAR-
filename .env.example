# ==============================================================================
# UrjaSetu EMS Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or production deployment.
# NEVER commit .env or files with real credentials to source control.
# Values below are documentation placeholders with safe non-production defaults.
# ==============================================================================

# --- Node & Environment Runtime ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# --- Database (PostgreSQL 16 with PostGIS 3.4 extension) ---
# For Docker Compose, host is 'db': postgresql://avishkar:${POSTGRES_PASSWORD}@db:5432/avishkar
# For local host / WSL: postgresql://avishkar:${POSTGRES_PASSWORD}@localhost:5432/avishkar_dev?schema=public
POSTGRES_USER=avishkar
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=avishkar
DATABASE_URL=postgresql://avishkar:CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD@localhost:5432/avishkar_dev?schema=public
# Dedicated throwaway database for automated test suites
DATABASE_URL_TEST=postgresql://avishkar:CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD@localhost:5432/avishkar_test?schema=public

# --- Session & Security Secrets ---
# Minimum 32-character random string for HMAC CSRF and session signing.
# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHARACTERS_RANDOM_SECRET
SESSION_TTL_HOURS=336
# In production, set to true to enforce Secure cookie flags over HTTPS
COOKIE_SECURE=false
# Set to true ONLY when operating behind a trusted reverse proxy (NGINX, Caddy, Cloudflare, ALB)
TRUST_PROXY=false

# --- Python Engine Microservice ---
# Private URL for the FastAPI/EMHASS mathematical optimization engine
ENGINE_URL=http://127.0.0.1:8090
# Secret authentication key (minimum 16 characters) shared between API and Engine
ENGINE_API_KEY=CHANGE_ME_TO_AT_LEAST_16_CHARACTERS_KEY

# --- Web Frontend & Map Tile Provider ---
# Public URL of the Fastify API (used for Next.js same-origin proxy rewrites)
API_URL=http://127.0.0.1:8080
# Production map tile service (e.g. MapTiler, Stadia, CARTO, or self-hosted Protomaps).
# Leave empty to use development default (public OpenStreetMap raster tiles).
# MapTiler example: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_MAPTILER_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_OSM_TILE_URL=

# --- Upstream Data Providers & Etiquette ---
# Must identify your instance with contact information (required by OSM/Nominatim usage policies)
PROVIDER_USER_AGENT=UrjaSetuEMS/1.0 (+https://github.com/ramnivasattanti2008-cloud/AVISHKAR-)
PROVIDER_TIMEOUT_MS=10000
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com
WEATHER_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com
WEATHER_API_KEY=
SOLAR_RESOURCE_PROVIDER=nasa-power
SOLAR_RESOURCE_BASE_URL=https://power.larc.nasa.gov
BUILDING_FOOTPRINT_PROVIDER=overpass
BUILDING_FOOTPRINT_BASE_URL=https://overpass-api.de
SATELLITE_PROVIDER=earth-search
SATELLITE_BASE_URL=https://earth-search.aws.element84.com/v1

# --- Optional AI Copilot Integration ---
# Optional Anthropic API key to enable dynamic natural language explanations.
# If left blank, the Copilot answers reliably from deterministic grounded templates.
ANTHROPIC_API_KEY=

# --- Background Job Scheduler ---
# Enable on exactly ONE API instance in cluster to prevent duplicate job executions
JOBS_ENABLED=false

# --- Hardware / NavIC Receivers ---
# Hardware abstraction flags; keep false unless real NavIC GNSS receiver is connected
NAVIC_RECEIVER_ENABLED=false
