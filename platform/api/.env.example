# Copy to .env for local development. Never commit .env. Values here are placeholders, not working secrets.

NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# PostgreSQL with the PostGIS extension (spec section 52). The migration creates the extension: either use a role that
# may CREATE EXTENSION, or enable PostGIS once from your provider's console first.
DATABASE_URL=postgresql://avishkar:CHANGE_ME@localhost:5432/avishkar_dev?schema=public
# A throwaway database used only by the integration tests (migrations are applied to it automatically).
DATABASE_URL_TEST=postgresql://avishkar:CHANGE_ME@localhost:5432/avishkar_test?schema=public

# HMAC key for CSRF tokens, at least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=336
# Cookies are Secure in production. Set false only for plain-http local development.
COOKIE_SECURE=
# Set true only behind a reverse proxy you control, so rate limiting and audit logs see the real client address.
TRUST_PROXY=false

# Providers. Defaults are the public endpoints and need no key. Each public provider has a usage policy:
# keep the User-Agent identifying (with a contact), do not remove the caching, do not raise request rates.
PROVIDER_USER_AGENT=AVISHKAR/0.1 (+https://github.com/ramnivasattanti2008-cloud/AVISHKAR-)
PROVIDER_TIMEOUT_MS=10000
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com
WEATHER_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com
WEATHER_API_KEY=
SOLAR_RESOURCE_PROVIDER=nasa-power
SOLAR_RESOURCE_BASE_URL=https://power.larc.nasa.gov
BUILDING_FOOTPRINT_PROVIDER=overpass
BUILDING_FOOTPRINT_BASE_URL=https://overpass-api.de
SATELLITE_PROVIDER=earth-search
SATELLITE_BASE_URL=https://earth-search.aws.element84.com/v1
MAP_PROVIDER=osm-raster

# Leave false unless a real NavIC-capable receiver integration exists. The API then refuses to label any position NavIC.
NAVIC_RECEIVER_ENABLED=false

# URL of the Python engine service (forecast, optimise, simulate) once it exists.
ENGINE_URL=
# Shared with the engine's ENGINE_API_KEY (at least 16 characters; required in production when ENGINE_URL is set).
ENGINE_API_KEY=

# Optional: lets a language model word the Copilot's answers. Its wording is checked against the tools' results and dropped if it
# states a number no tool returned. Without a key the Copilot answers from templates. Never commit a real key.
ANTHROPIC_API_KEY=

# Background jobs (forecast scoring, weather and satellite refresh, tariff checks). Off by default. With several API processes,
# switch it on for one of them: the database stops two from running the same job at once.
JOBS_ENABLED=false
