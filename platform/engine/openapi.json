            },
            "title": "Exportprice",
            "type": "array"
          },
          "grid": {
            "$ref": "#/components/schemas/GridIn"
          },
          "importPrice": {
            "description": "INR per kWh bought from the grid, per step.",
            "items": {
              "type": "number"
            },
            "title": "Importprice",
            "type": "array"
          },
          "loadKw": {
            "items": {
              "type": "number"
            },
            "title": "Loadkw",
            "type": "array"
          },
          "mode": {
            "default": "SAVE_MONEY",
            "enum": [
              "SAVE_MONEY",
              "INDEPENDENCE",
              "RESILIENCE",
              "GREEN",
              "REVENUE",
              "BALANCED"
            ],
            "title": "Mode",
            "type": "string"
          },
          "pvKw": {
            "items": {
              "type": "number"
            },
            "title": "Pvkw",
            "type": "array"
          },
          "startTime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
