  "info": {
    "description": "Planning, forecasting and simulation for the AVISHKAR platform. Stateless and internal: send the data, get the arithmetic and how it was done.",
    "title": "AVISHKAR engine",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Is the engine up",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/optimise": {
      "post": {
        "description": "Choose battery, grid, solar, EV and appliance schedules that minimise a mode-weighted cost. The plan is re-checked\nfrom scratch before it is returned (`validation`); an invalid plan must not be shown as a plan.",
        "operationId": "plan_v1_optimise_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-engine-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Engine-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimiseRequest"
              }
            }
          },
