          "startStep": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "First step of a non-interruptible run; None for an interruptible one.",
            "title": "Startstep"
          }
        },
        "required": [
          "id",
          "name",
          "startStep",
          "runSteps",
          "energyKwh"
        ],
        "title": "ApplianceResult",
        "type": "object"
      },
      "Baseline": {
