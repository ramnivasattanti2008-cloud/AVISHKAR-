            "title": "Minsockwh",
            "type": "number"
          },
          "reserveSocKwh": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Kept back for backup outside an outage; None for no reserve.",
            "title": "Reservesockwh"
