          "maxDischargeKw": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Maxdischargekw",
            "type": "number"
          },
          "maxSocKwh": {
            "exclusiveMinimum": 0.0,
            "title": "Maxsockwh",
