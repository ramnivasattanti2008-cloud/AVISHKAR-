{
  "components": {
    "schemas": {
      "ApplianceIn": {
        "additionalProperties": false,
        "properties": {
          "durationSteps": {
            "minimum": 1.0,
            "title": "Durationsteps",
            "type": "integer"
          },
          "earliestStartStep": {
            "minimum": 0.0,
            "title": "Earlieststartstep",
            "type": "integer"
          },
          "id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "interruptible": {
            "default": false,
            "title": "Interruptible",
            "type": "boolean"
          },
          "latestFinishStep": {
            "description": "Exclusive: the run must be over before this step starts.",
            "exclusiveMinimum": 0.0,
            "title": "Latestfinishstep",
            "type": "integer"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "powerKw": {
            "exclusiveMinimum": 0.0,
            "maximum": 1000.0,
            "title": "Powerkw",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "powerKw",
          "durationSteps",
          "earliestStartStep",
          "latestFinishStep"
        ],
        "title": "ApplianceIn",
        "type": "object"
      },
