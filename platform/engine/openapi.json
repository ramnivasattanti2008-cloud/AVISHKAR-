          },
          "stepHours": {
            "title": "Stephours",
            "type": "number"
          },
          "timeLimitS": {
            "default": 20,
            "exclusiveMinimum": 0.0,
            "maximum": 120.0,
            "title": "Timelimits",
            "type": "number"
