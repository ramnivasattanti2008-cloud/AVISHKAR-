# Files whose content is checksummed or executed by a shell must keep LF line endings on every platform.
*.sh text eol=lf
*.sql text eol=lf
platform/api/prisma/migrations/** text eol=lf
*.cmd text eol=crlf

# Source and generated code/spec files must keep LF line endings across platforms
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.md text eol=lf

