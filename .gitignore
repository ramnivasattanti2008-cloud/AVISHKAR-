__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
venv/
.venv/
*.egg-info/

# Generated at runtime, never commit (see CLAUDE.md, "Data and caches").
# Dashboard result cache, filled by scripts/precompute_cache.py:
data/cache/
# Written by the vendored EMHASS code and its tests:
data/last_run.json
data/adjust_pv_regressor.pkl
data/debug-*.csv
# Scratch copy of a meter file uploaded in the dashboard:
data/real/uploaded_*.csv
# examples/analyze_my_site.py output:
my_site_report.md
.streamlit/credentials.toml
.claude/settings.local.json

# Weather cached for ad-hoc "my-site" analyses (examples/analyze_my_site.py, dashboard upload tab):
data/real/pvgis_my-site_*.csv

# platform (Node/Next.js)
node_modules/
.next/
dist/
*.tsbuildinfo
coverage/

# Environment files and secrets (never commit secrets)
.env
.env.*
.env.local
platform/**/.env
platform/**/.env.*
platform/**/.env.local
!.env.example
!**/.env.example

# Real secret files (any name starting with secrets_) are never committed. The one exception is the
# documented template, which carries only placeholders and is tracked so the names exist.
secrets_*.yaml
secrets_*.yml
!secrets_emhass(example).yaml

# Database backups and recovery dumps
*.dump
*.dump.*
*.dump.sha256
*.dump.gpg
*.dump.gpg.sha256
*.dump.enc
*.dump.enc.sha256
# Database backups and recovery dumps
*.dump
*.dump.sha256
*.sql.gz
platform/backups/
backups/

# Prisma client is generated (pnpm db:generate), never committed
platform/api/src/generated/

# SQLite databases
*.db
*.db-journal
*.sqlite

# Local binaries and tunnel tools (downloaded at runtime)
tools/
*.exe


# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
